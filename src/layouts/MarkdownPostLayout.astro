---
import BlogLayout from "./BlogLayout.astro";
const { frontmatter } = Astro.props;
---

<BlogLayout pageTitle={frontmatter.title}>
  <header class="my-8 flex flex-col">
    <h1
      class="text-foreground max-w-4xl pb-8 pl-4 text-left text-6xl leading-[52px] font-medium tracking-tighter text-balance capitalize min-[520px]:leading-16 min-[800px]:leading-20 sm:text-8xl sm:tracking-tight lg:leading-28"
    >
      {frontmatter.title}
    </h1>
  </header>

  <div class="mb-8 px-4 text-left">
    <slot />
  </div>
</BlogLayout>
