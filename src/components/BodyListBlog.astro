---
const { post } = Astro.props;
import ArroRightLink from "../icons/ArrowRightLink.astro";
---

<div class="flex flex-col pt-10">
  <p class="max-w-xl text-sm/7 text-gray-600 dark:text-gray-400">
    {post.description ? post.description : "There is no description"}
  </p>
</div>

<button class="text-foreground font-medium underline decoration-neutral-950/20 dark:decoration-stone-700 underline-offset-4 hover:decoration-3  mt-10 flex cursor-pointer items-center gap-2">
  See it now
  <ArroRightLink />
</button>
