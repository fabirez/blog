---
const { post } = Astro.props;
import ArroRightLink from "../icons/ArrowRightLink.astro";
---

<div class="flex flex-col pt-10">
  <p class="max-w-xl text-sm/7 text-gray-600 dark:text-gray-400">
    {post.description ? post.description : "There is no description"}
  </p>
</div>

<button
  class="text-foreground decoration-accent mt-10 flex cursor-pointer items-center gap-2 font-medium underline underline-offset-4 hover:decoration-3"
>
  See it now
  <ArroRightLink />
</button>
