---
const { post } = Astro.props;
import { Icon } from "astro-icon/components";
---

<div class="flex flex-col pt-10">
  <p class="max-w-xl text-sm/7 text-gray-600 dark:text-gray-400">
    {post.description ? post.description : "There is no description"}
  </p>
</div>

<button class="text-accent flex items-center gap-2 mt-10 cursor-pointer border ">
  See it now
  <Icon name="arrow_link-icon" />
</button>
