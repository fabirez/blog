---
import { getCollection } from "astro:content";
import ListBlog from "./ListBlog.astro";

const posts = await getCollection("blog");

const postProps = posts.map((p) => {
  return { ...p.data, url: p.id };
});
---

<section class="mt-20 w-full">
  <ul role="list" class="flex w-fit flex-col gap-20 pl-4">
    {
      postProps.map((post) => (
        <li>
          <ListBlog post={post} />
        </li>
      ))
    }
  </ul>
</section>
