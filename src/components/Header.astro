---
import Asterisk from "../icons/Asterisk.astro"
import Caffeine from "../icons/Caffeine.astro"
import ThemeToggle from "./ui/ThemeToggle.astro";

const linksNav = [
  {
    nameLink: "here",
    link: "/",
  },
];
---

<header class="mx-2 mt-8 flex items-center justify-between lg:mx-4 lg:w-5xl">
  <a href="/" class="flex">
    <div class="cont_logo flex items-center">
      <Caffeine />
      <div class="flex h-8 items-start">
        <Asterisk class="asterisk"/>
      </div>
    </div>
  </a>

  <nav>
    <ul class="flex gap-8">
      {
        linksNav.map(({ nameLink, link }) => (
          <li class="list-none [.blog_&]:!mt-0">
            <a href={link} class="link">
              {nameLink}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ThemeToggle />
</header>
