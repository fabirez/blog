---

export async function getStaticPaths() {
  return [
    {
      params: {
        tag: "general",
      },
    },
    {
      params: {
        tag: "courses",
      },
    },
    {
      params: {
        tag: "ossu",
      },
    }
  ];
}


const {tag} = Astro.params;
---
<BaseLayout pageTitle={tag}>
  <p>Posts tagged with {tag}</p>
</BaseLayout>
