---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListBlog from "../../components/ListBlog.astro";
import type { Post } from "../../lib/types.ts";
import { SITE_TITLE } from "../../lib/site.ts";
import { getCollection } from "astro:content";

interface Props {
  posts: Post[];
}
// Require for dynamic paths
// https://docs.astro.build/en/guides/routing/#static-ssg-mode
export async function getStaticPaths() {
  const data = await getCollection("blog");

  const posts: Post[] = Object.values(data).map((post) => {
    return { ...post.data, url: post.id };
  });

  const uniqueTags: string[] = [...new Set(posts.map((post) => post.genre))];

  return uniqueTags.map((tag) => {
    return {
      params: {
        tag,
      },
      props: {
        posts,
      },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={SITE_TITLE + " " + tag}>
  <section class="mt-20 w-full">
    <ul role="list" class="flex w-fit flex-col gap-20 pl-4">
      {
        posts
          .filter((post) => post.genre === tag)
          .map((post) => (
            <li>
              <ListBlog post={post} />
            </li>
          ))
      }
    </ul>
  </section>
</BaseLayout>
