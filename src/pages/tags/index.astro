<section class="mt-20 w-full lg:w-5xl">
  <ul role="list" class="px-4">
    {uniqueTags.map((tag) => 
    <li class="border-t border-black/10">
        <a class="flex  gap-40 w-full group text-foreground text-sm/7  py-5 pr-4 pl-6 sm:pr-2 sm:pl-4" href={`/tags/${tag}`}>
          <p class="capitalize font-medium underline decoration-neutral-950/20 dark:decoration-stone-700 underline-offset-4 group-hover:decoration-3 text-nowrap"> # {tag}</p>

          <p class="text-gray-600 dark:text-gray-400 text-sm/7 max-w-xl">
            {DESCRIPTION_GENRE[tag]} 
        </p>
      </a>
    </li>
    )}


  </ul>
</section> 

</BaseLayout>
