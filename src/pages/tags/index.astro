---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DESCRIPTION_GENRE } from "../../lib/data";
import type { Tags } from "../../schema/schema";
import { getCollection } from "astro:content";

const data = await getCollection("blog");
const uniqueTags: Tags[] = [
  ...new Set(
    Object.values(data).map((post) => {
      return post.data.genre;
    }),
  ),
];
---

<BaseLayout pageTitle="All Tags">
  <section class="mt-20 w-full lg:w-5xl">
    <ul role="list" class="px-4">
      {
        uniqueTags.map((tag) => (
          <li class="border-t border-black/10">
            <a
              class="group text-foreground flex w-full gap-40 py-5 pr-4 pl-6 text-sm/7 sm:pr-2 sm:pl-4"
              href={`/tags/${tag}`}
            >
              <p class="font-medium text-nowrap capitalize underline decoration-neutral-950/20 underline-offset-4 group-hover:decoration-3 dark:decoration-stone-700">
                {" "}
                # {tag}
              </p>

              <p class="max-w-xl text-sm/7 text-gray-600 dark:text-gray-400">
                {DESCRIPTION_GENRE[tag]}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
